.DS_Store
**/.DS_Store
.build/
build/
dist/
Package.resolved

# Local developer documentation; public release notes stay tracked
/Docs/**/*.md
!/Docs/ReleaseNotes/**/*.md
/RELEASING.md
/telemetry/server/*.md

# Local-only test suite
/Tests/
!/Tests/
/Tests/*
!/Tests/TelemetryTests/

# Telemetry development state and credentials
telemetry/server/node_modules/
telemetry/server/.wrangler/
telemetry/server/.dev.vars*
telemetry/server/wrangler.production.json
telemetry/server/remote-inspection/
telemetry/server/.test-output/
**/.wrangler/

# Local editor and Xcode state
.vscode/
.swiftpm/
**/xcuserdata/
*.xcuserstate

# Release keys are embedded locally and must never be committed
/Config/MetadataKeys.plist
/Config/SparklePrivateKey*
/.release-secrets/

# Website source is maintained in a separate private repository
/torrserve-silicon-github-pages/
